# ==============================================================================
# FitCheck AI API - Environment Variables Template
# Copy file này thành .env và điền các thông tin bí mật trước khi khởi chạy ứng dụng.
# KHÔNG ĐƯỢC COMMIT FILE .env LÊN GITHUB HOẶC NỀN TẢNG PUBLIC!
# ==============================================================================

# Database & Redis
DATABASE_URL=postgresql://user:password@localhost:5432/fitcheck_db
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & JWT Authentication
# Sinh chuỗi ngẫu nhiên bằng lệnh: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_in_production

# Weather & Image Processing Utilities
WEATHER_API_KEY=your_weather_api_key_here
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_STORAGE_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=ap-southeast-1
# AWS_ENDPOINT_URL= # Dùng khi sử dụng Cloudflare R2 hoặc MinIO S3 compatible

# AI API Keys (Google Gemini API hoặc OpenAI API)
# Lấy Gemini Key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# OPENAI_API_KEY=your_openai_api_key_here

# MLOps & Observability (LangSmith Tracing)
# Đăng ký tài khoản miễn phí tại: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key_here

LANGCHAIN_PROJECT=fitcheck-ai-backend
